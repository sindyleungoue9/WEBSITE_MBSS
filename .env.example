# Copiez ce fichier en ".env.local" et remplissez les valeurs.
# Ne mettez JAMAIS le fichier ".env.local" sur GitHub (il est déjà ignoré).

# Adresse publique du site (utilisée pour le référencement, le sitemap, les liens)
NEXT_PUBLIC_SITE_URL=https://mbss-sarl.com

# UNE seule adresse e-mail professionnelle, affichée sur le site
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Envoi des demandes de devis (service Resend : https://resend.com) ---
RESEND_API_KEY=
# Adresse qui reçoit les demandes de devis
QUOTE_TO_EMAIL=
# Expéditeur (le domaine doit être vérifié dans Resend). Pour tester : onboarding@resend.dev
QUOTE_FROM_EMAIL="MBSS Devis <onboarding@resend.dev>"

# --- Anti-spam Cloudflare Turnstile (optionnel, gratuit) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Informations légales (affichées dans les mentions légales si remplies) ---
NEXT_PUBLIC_LEGAL_RCCM=
NEXT_PUBLIC_LEGAL_NIU=
